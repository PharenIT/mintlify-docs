{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Pharen",
  "description": "Documentation for Pharen Hub — the AI workspace that unifies docs, lists, channels, mail, and agents so your team can automate workflows and move faster.",
  "colors": {
    "primary": "#158065",
    "light": "#158065",
    "dark": "#6ee7b7"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "url": "full",
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required",
      "prefill": true
    }
  },
  "logo": {
    "light": "https://media.brand.dev/70fa3769-6705-48e9-8340-cef95a902e88.svg",
