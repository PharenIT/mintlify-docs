{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Pharen",
  "description": "Documentation for Pharen Hub — the AI workspace that unifies docs, lists, channels, mail, and agents so your team can automate workflows and move faster.",
  "colors": {
    "primary": "#18181B",
    "light": "#18181B",
    "dark": "#E4E4E7"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "url": "full",
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required",
      "prefill": true
    }
  },
  "logo": {
    "light": "https://media.brand.dev/70fa3769-6705-48e9-8340-cef95a902e88.svg",
    "dark": "https://media.brand.dev/de991512-f9de-434e-866d-6c978fec7b16.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Open Hub",
      "href": "https://pharen.app"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "products": [
          {
            "$ref": "navigation/en/pharen-ui.json"
          },
          {
            "$ref": "navigation/en/pharen-hub.json"
          }
        ]
      },
      {
        "language": "de",
        "products": [
          {
            "$ref": "navigation/de/pharen-ui.json"
          },
          {
            "$ref": "navigation/de/pharen-hub.json"
          }
        ],
        "navbar": {
          "primary": {
            "type": "button",
            "label": "Zum Hub",
            "href": "https://pharen.app"
          }
        },
        "footer": {
          "socials": {
            "linkedin": "https://linkedin.com/company/pharen"
          }
        }
      }
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/general/overview",
      "permanent": false
    },
    {
      "source": "/docs/overview",
      "destination": "/general/overview",
      "permanent": false
    },
    {
      "source": "/de",
      "destination": "/de/general/overview",
      "permanent": false
    },
    {
      "source": "/de/docs/overview",
      "destination": "/de/general/overview",
      "permanent": false
    }
  ],
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/pharen"
    }
  }
}
